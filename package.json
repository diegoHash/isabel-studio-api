{
  "name": "isabel-studio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de citas para Isabel Rojas Studio de Uñas (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply isabel-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply isabel-studio --remote",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
